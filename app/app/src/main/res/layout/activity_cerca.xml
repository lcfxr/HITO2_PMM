<?xml version="1.0" encoding="utf-8"?>
<!-- PANTALLA PARADA MAS CERCANA -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="16dp"
    android:fitsSystemWindows="true">

    <!-- TITULO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_cerca"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- EXPLICACION -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/texto_cerca"
        android:layout_marginBottom="24dp"/>

    <!-- BOTON BUSCAR -->
    <Button
        android:id="@+id/btnBuscarParada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_buscar_parada"/>

    <!-- RESULTADO -->
    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="18sp"
        android:padding="16dp"
        android:visibility="gone"/>

    <!-- BOTON ABRIR AJUSTES -->
    <Button
        android:id="@+id/btnAbrirAjustes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/btn_abrir_ajustes"
        android:visibility="gone"/>

    <!-- HUECO -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- BOTON VOLVER -->
    <Button
        android:id="@+id/btnVolverCerca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_volver"/>

</LinearLayout>