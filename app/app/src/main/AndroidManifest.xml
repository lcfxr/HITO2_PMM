<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISO DE INTERNET -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- PERMISO PARA MIRAR SI HAY CONEXION -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- PERMISOS DE UBICACION (HAY QUE PEDIRLOS AL USUARIO) -->
    <!-- APROXIMADA -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- PRECISA -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ACT2_UD1">

        <!-- PANTALLA DE INICIO -->
        <activity
            android:name=".BienvenidaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LISTADO -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- DETALLE -->
        <activity
            android:name=".DetalleActivity"
            android:exported="false" />

        <!-- FORMULARIO -->
        <activity
            android:name=".FormularioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- CONSORCIO -->
        <activity
            android:name=".ConsorcioActivity"
            android:exported="false" />

        <!-- PARADA MAS CERCANA -->
        <activity
            android:name=".CercaActivity"
            android:exported="false" />

    </application>

</manifest>